# ============================================================================
# GeneralStaff — Production Environment Variables Template
# Copy to .env.prod and fill in values for production deployment
# ============================================================================

# ----------------------------------------------------------------------------
# Domain & SSL
# ----------------------------------------------------------------------------
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_DB=generalstaff
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-use-a-strong-random-password

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_PASSWORD=changeme-use-a-strong-random-password

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database URL (constructed from above)
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Redis URL (constructed from above)
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# JWT Authentication
JWT_SECRET=changeme-use-a-strong-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=changeme-use-a-different-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Anthropic API (for AI analysis)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# API Version
API_VERSION=0.1.0

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
HELMET_CSP_ENABLED=true

# ----------------------------------------------------------------------------
# Optional: Monitoring & Logging
# ----------------------------------------------------------------------------
# LOG_LEVEL=info
# SENTRY_DSN=
# DATADOG_API_KEY=

# ----------------------------------------------------------------------------
# Optional: Feature Flags
# ----------------------------------------------------------------------------
# ENABLE_SWAGGER=false
# ENABLE_METRICS=true