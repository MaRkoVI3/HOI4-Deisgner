{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "skipLibCheck": true,
    "noEmit": false,
    "paths": {
      "@generalstaff/shared-types": ["../../packages/shared-types/dist"],
      "@generalstaff/calculation-engine": ["../../packages/calculation-engine/dist"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}