'use client';

import { useState, useMemo, useCallback } from 'react';
import {
  Button,
  Input,
  Select,
  Badge,
  Tooltip,
  TooltipProvider,
  Card,
  CardHeader,
  CardTitle,
  CardContent,
  StatCard,
  DivisionCard,
  EquipmentCard,
  Alert,
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
  cn,
} from '@generalstaff/ui-components';
import {
  Plus,
  Minus,
  Trash2,
  Copy,
  Download,
  Upload,
} from 'lucide-react';
import type {
  BattalionInstance,
  SupportCompanyInstance,
  EquipmentVariant,
  EquipmentCategory,
  CountryTag,
  DivisionStats,
  DivisionTemplate,
  SupportCompanyType,
} from '@generalstaff/shared-types';
import {
  calculateDivisionStats,
  validateDivision,
  isDivisionValid,
  getValidationErrors,
  getValidationWarnings,
  STAT_DEFINITIONS,
  type CalculationContext,
} from '@generalstaff/calculation-engine/division';

// ============================================================================
// Types
// ============================================================================

// Map shared-types to page-specific types
type Regiment = BattalionInstance & { type: string; position: number };
type SupportCompany = SupportCompanyInstance & { type: string };
type Equipment = EquipmentVariant;

// Local support types
const SUPPORT_TYPES: Array<{ value: string; label: string }> = [
  { value: 'engineer', label: 'Engineers' },
  { value: 'recon', label: 'Recon' },
  { value: 'logistics', label: 'Logistics' },
  { value: 'signal', label: 'Signal' },
  { value: 'maintenance', label: 'Maintenance' },
  { value: 'hospital', label: 'Hospital' },
  { value: 'military_police', label: 'Military Police' },
  { value: 'anti_air', label: 'Anti-Air' },
  { value: 'anti_tank', label: 'Anti-Tank' },
  { value: 'artillery', label: 'Artillery' },
];

const REGIMENT_TYPES: Array<{ value: string; label: string }> = [
  { value: 'infantry', label: 'Infantry' },
  { value: 'artillery', label: 'Artillery' },
  { value: 'armor', label: 'Armor' },
  { value: 'special', label: 'Special' },
  { value: 'armor', label: 'Armor' },
  { value: 'special', label: 'Special' },
];

// Empty equipment assignments helper
const emptyEquipmentAssignments: Record<EquipmentCategory, string | undefined> = {
  infantry_equipment: undefined,
  support_equipment: undefined,
  artillery_equipment: undefined,
  armor_equipment: undefined,
  motorized_equipment: undefined,
  mechanized_equipment: undefined,
  anti_air_equipment: undefined,
  anti_tank_equipment: undefined,
  rocket_artillery_equipment: undefined,
  small_arms: undefined,
  support: undefined,
  artillery: undefined,
  anti_tank: undefined,
  anti_air: undefined,
  rocket_artillery: undefined,
  light_tank: undefined,
  medium_tank: undefined,
  heavy_tank: undefined,
  motorized: undefined,
  mechanized: undefined,
  recon: undefined,
  engineer: undefined,
  military_police: undefined,
};

